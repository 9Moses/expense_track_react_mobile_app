{
  "expo": {
    "name": "Expense Tracker",
    "slug": "Expense Tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/expense.png",
    "scheme": "Expense Tracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/expense.png",
        "backgroundColor": "#6366F1",
        "backgroundImage": "./assets/images/adaptive-background.png"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/expense.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-logo-dark.png",
            "backgroundColor": "#0F172A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "process.env.EXPO_PUBLIC_API_URL"
    }

  }
}